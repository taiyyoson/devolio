# Supabase — powers the terminal's /login command and gates /write.
# Without these the site still runs; login and publishing go dark.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The one account allowed to publish. Authentication alone is NOT enough:
# the anon key above is public, so if signups are enabled in the Supabase project
# then "has a valid session" means "anyone". This is the authorization check.
#
# Find it in Supabase -> Authentication -> Users -> your user's UID.
# If unset, /write and /api/posts deny everyone — it fails closed on purpose.
OWNER_USER_ID=

# GitHub — lets /write commit blog posts back to this repo.
# Server-side only. Never prefix with NEXT_PUBLIC_, or the token ships to browsers.
#
# Use a fine-grained personal access token scoped to THIS repository only:
#   Repository permissions -> Contents: Read and write
#   Leave every other permission, especially Workflows, set to No access.
# Without Workflows access a leaked token cannot rewrite .github/workflows and
# hijack CI.
GITHUB_TOKEN=
GITHUB_REPO=taiyyoson/devolio
GITHUB_BRANCH=main
